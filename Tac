local function isTeammate(targetPlayer)
    if not Config.TeamCheck then return false end
    return player.Team and targetPlayer.Team and player.Team == targetPlayer.Team
end

local function getAimTarget()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not camera then return nil end

    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local bestTargetHead = nil
    local bestDist = Config.FOV

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        pcall(function()
            if targetPlayer ~= player and not isTeammate(targetPlayer) then
                local tChar = targetPlayer.Character
                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                local tHead = tChar and tChar:FindFirstChild(Config.TargetPart)
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

                if tHum and tHum.Health > 0 and tHead and tRoot then
                    local worldDist = (root.Position - tRoot.Position).Magnitude
                    if worldDist <= Config.MaxDistance then
                        local screenPos, visible = camera:WorldToViewportPoint(tHead.Position)
                        if visible and screenPos.Z > 0 then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                            if dist < bestDist then
                                if Config.WallCheck then
                                    local params = RaycastParams.new()
                                    params.FilterType = Enum.RaycastFilterType.Exclude
                                    params.FilterDescendantsInstances = {char}
                                    local rayResult = Workspace:Raycast(camera.CFrame.Position, tHead.Position - camera.CFrame.Position, params)
                                    if rayResult and rayResult.Instance and rayResult.Instance:IsDescendantOf(tChar) then
                                        bestDist = dist
                                        bestTargetHead = tHead
                                    end
                                else
                                    bestDist = dist
                                    bestTargetHead = tHead
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    -- Hiển thị FOV độc lập với AimAssist
    if fovCircle then
        pcall(function()
            fovCircle.Visible = Config.EnableFOV
            fovCircle.Radius = Config.FOV
            fovCircle.Position = center
        end)
    end

    return bestTargetHead
end

