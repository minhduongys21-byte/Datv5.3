-- RENDER STEPPED (TỐI ƯU HÓA KHUNG HÌNH)
--==================================================
RunService.RenderStepped:Connect(function(deltaTime)
    pcall(function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        -- 1. WalkSpeed
        if hum and not Config.Fly then
            hum.WalkSpeed = Config.Speed and Config.SpeedValue or 16
        end

        -- 2. Fly Logic
        if Config.Fly and not Config.TeleportToTarget and root and hum and camera then
            if not bv or not bv.Parent or not bg or not bg.Parent then 
                startFly() 
            end
            if bv and bg then
                hum.PlatformStand = true
                bg.CFrame = camera.CFrame
                local speed = Config.FlyValue or 50
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    local rawMove = (camera.CFrame.LookVector * (-camera.CFrame:VectorToObjectSpace(moveDir).Z)) + (camera.CFrame.RightVector * (camera.CFrame:VectorToObjectSpace(moveDir).X))
                    bv.Velocity = rawMove * speed
                    holdPosition = root.Position
                else
                    bv.Velocity = Vector3.zero
                    if holdPosition then
                        root.CFrame = CFrame.new(holdPosition, holdPosition + camera.CFrame.LookVector)
                    end
                end
            end
        else
            if bv or bg then stopFly() end
        end

        -- 3. Gun & Ammo
        handleGunAndAmmo()

        -- 4. Teleport to Target (Sau lưng địch)
        if Config.TeleportToTarget and char and root then
            local enemyRoot, enemyHead = nil, nil
            local shortestDist = Config.MaxDistance
            
            for _, targetPlayer in ipairs(Players:GetPlayers()) do
                pcall(function()
                    if targetPlayer ~= player and not isTeammate(targetPlayer) then
                        local tChar = targetPlayer.Character
                        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                        local tHead = tChar and tChar:FindFirstChild("Head")
                        if tHum and tHum.Health > 0 and tRoot and tHead then
                            local dist = (root.Position - tRoot.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                enemyRoot = tRoot
                                enemyHead = tHead
                            end
                        end
                    end
                end)
            end

            if enemyRoot and enemyHead then
                root.CanCollide = false
                local behindCF = enemyRoot.CFrame * CFrame.new(0, 0, 3)
                local targetCF = CFrame.lookAt(behindCF.Position, Vector3.new(enemyHead.Position.X, behindCF.Position.Y, enemyHead.Position.Z), Vector3.yAxis)
                root.CFrame = targetCF
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
                if camera then
                    local targetCamCF = CFrame.new(camera.CFrame.Position, enemyHead.Position)
                    camera.CFrame = camera.CFrame:Lerp(targetCamCF, 0.4)
                end
            end
        else
            if root then root.CanCollide = true end
