local function isTeammate(targetPlayer)
    if not Config.TeamCheck then return false end
    return player.Team and targetPlayer.Team and player.Team == targetPlayer.Team
end

-- HÀM AIM MỚI TỪ SCRIPT BẠN CUNG CẤP
local function obtenerPosicionApuntado()
    local cam = Workspace.CurrentCamera
    if not player.Character then
        return cam.CFrame.Position
    end
    
    local arma = nil
    for _, tool in ipairs(player.Character:GetChildren()) do
        if tool:IsA("Tool") then
            local handle = tool:FindFirstChild("Handle") or tool:FindFirstChild("Part")
            if handle then
                arma = handle
                break
            end
        end
    end
    
    if arma then
        return arma.Position
    end
    
    return cam.CFrame.Position
end

local function hayParedEntre(posicionInicio, posicionFinal)
    if not Config.WallCheck then
        return false
    end
    
    local direccion = (posicionFinal - posicionInicio).Unit
    local distancia = (posicionFinal - posicionInicio).Magnitude
    
    local parametrosRaycast = RaycastParams.new()
    parametrosRaycast.FilterType = Enum.RaycastFilterType.Exclude
    
    local objetosIgnorar = {}
    if player.Character then
        table.insert(objetosIgnorar, player.Character)
    end
    parametrosRaycast.FilterDescendantsInstances = objetosIgnorar
    parametrosRaycast.IgnoreWater = true
    
    local resultado = Workspace:Raycast(posicionInicio, direccion * distancia, parametrosRaycast)
    
    if resultado then
        local parteGolpeada = resultado.Instance
        if parteGolpeada and parteGolpeada:IsDescendantOf(Workspace) then
            local modelo = parteGolpeada:FindFirstAncestorOfClass("Model")
            if modelo then
                local jugador = Players:GetPlayerFromCharacter(modelo)
                if jugador and jugador ~= player then
                    return false
                end
            end
        end
        return true
    end
    
    return false
end

local function aplicarAjusteDistancia(posicionTarget)
    if not Config.AjusteDistanciaActivo then
        return posicionTarget
    end
    
    local posicionApuntado = obtenerPosicionApuntado()
    local direccion = (posicionTarget - posicionApuntado).Unit
    local distancia = (posicionTarget - posicionApuntado).Magnitude
    
    local nuevaDistancia = distancia + Config.DistanciaAjuste
    return posicionApuntado + (direccion * nuevaDistancia)
end

local function getAimTarget()
    local jugadorMasCercano = nil
    local distanciaMasCorta = Config.MaxDistance
    local cam = Workspace.CurrentCamera
    
    for _, jugador in pairs(Players:GetPlayers()) do
        if jugador ~= player and not isTeammate(jugador) then
            if jugador.Character then
                local humanoide = jugador.Character:FindFirstChild("Humanoid")
                local targetPart = jugador.Character:FindFirstChild(Config.TargetPart) or jugador.Character:FindFirstChild("Head")
                local rootPart = jugador.Character:FindFirstChild("HumanoidRootPart")
                
                if humanoide and humanoide.Health > 0 and targetPart and rootPart then
                    local posicionApuntado = obtenerPosicionApuntado()
                    local distancia = (rootPart.Position - posicionApuntado).Magnitude
                    
                    if distancia <= Config.MaxDistance and distancia < distanciaMasCorta then
                        local screenPos, enPantalla = cam:WorldToViewportPoint(targetPart.Position)
                        
                        if enPantalla then
                            if not hayParedEntre(posicionApuntado, targetPart.Position) then
                                jugadorMasCercano = jugador
                                distanciaMasCorta = distancia
                            end
                        end
                    end
                end
            end
        end
    end
    
    if fovCircle and cam then
        pcall(function()
            local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
            fovCircle.Visible = Config.EnableFOV and Config.AimAssist
            fovCircle.Radius = Config.FOV
            fovCircle.Position = center
        end)
    end
    
    if jugadorMasCercano and jugadorMasCercano.Character then
        return jugadorMasCercano.Character:FindFirstChild(Config.TargetPart) or jugadorMasCercano.Character:FindFirstChild("Head")
    end

    return nil
end

