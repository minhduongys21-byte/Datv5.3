local function handleGunAndAmmo()
    pcall(function()
        local char = player.Character
        if not char then return end

        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end

        -- 1. BẮN KHÔNG NẠP ĐẠN
        if Config.InfiniteAmmo then
            for _, obj in ipairs(tool:GetDescendants()) do
                pcall(function()
                    if obj:IsA("ValueBase") then
                        local name = obj.Name:lower()
                        if name:find("ammo") or name:find("clip") or name:find("bullet") or name:find("mag") then
                            if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                                obj.Value = 999
                            end
                        end
                    end
                end)
            end
            for attrName, _ in pairs(tool:GetAttributes()) do
                pcall(function()
                    local lowerAttr = attrName:lower()
                    if lowerAttr:find("reload") then
                        tool:SetAttribute(attrName, false)
                    elseif lowerAttr:find("ammo") or lowerAttr:find("clip") then
                        tool:SetAttribute(attrName, 999)
                    end
                end)
            end
        end

        -- 2. TỐC ĐỘ BẮN NHANH
        if Config.RapidFire then
            for _, obj in ipairs(tool:GetDescendants()) do
                pcall(function()
                    if obj:IsA("ValueBase") then
                        local name = obj.Name:lower()
                        if name:find("cooldown") or name:find("firedelay") or name:find("firerate") or name:find("delay") then
                            if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                                obj.Value = 0.01 / Config.FireRateValue
                            end
                        end
                    elseif obj:IsA("ModuleScript") then
                        pcall(function()
                            local configModule = require(obj)
                            if type(configModule) == "table" then
                                for k, v in pairs(configModule) do
                                    local keyName = tostring(k):lower()
                                    if keyName:find("firerate") or keyName:find("cooldown") or keyName:find("shootdelay") then
                                        configModule[k] = 0.01 / Config.FireRateValue
                                    end
                                end
                            end
                        end)
                    end
                end)
            end

            if isMouseDown then
                local currentTime = tick()
                local interval = math.clamp(0.1 / Config.FireRateValue, 0.01, 0.2)
                if currentTime - lastShotTime >= interval then
                    lastShotTime = currentTime
                    pcall(function() tool:Activate() end)
                end
            end
        end

        -- 3. BẮN KHÔNG GIẬT SÚNG
        if Config.NoRecoil then
            for _, obj in ipairs(tool:GetDescendants()) do
                pcall(function()
                    if obj:IsA("ValueBase") then
                        local name = obj.Name:lower()
                        if name:find("recoil") or name:find("spread") or name:find("kick") or name:find("shake") or name:find("bloom") then
                            if obj:IsA("Vector3Value") then obj.Value = Vector3.zero
                            elseif obj:IsA("CFrameValue") then obj.Value = CFrame.new()
                            else obj.Value = 0 end
                        end
                    elseif obj:IsA("ModuleScript") then
                        pcall(function()
                            local configModule = require(obj)
                            if type(configModule) == "table" then
                                for k, v in pairs(configModule) do
                                    local keyName = tostring(k):lower()
                                    if keyName:find("recoil") or keyName:find("spread") or keyName:find("kick") or keyName:find("shake") or keyName:find("bloom") or keyName:find("camrecoil") then
                                        if type(v) == "number" then
                                            configModule[k] = 0
                                        elseif typeof(v) == "Vector3" then
                                            configModule[k] = Vector3.zero
                                        elseif typeof(v) == "CFrame" then
                                            configModule[k] = CFrame.new()
                                        end
                                    end
                                end
                            end
                        end)
                    end
                end)
            end

            for attrName, _ in pairs(tool:GetAttributes()) do
                pcall(function()
                    local lowerAttr = attrName:lower()
                    if lowerAttr:find("recoil") or lowerAttr:find("spread") or lowerAttr:find("kick") or lowerAttr:find("shake") then
                        tool:SetAttribute(attrName, 0)
                    end
                end)
            end
        end
    end)
end

-- Vòng lặp Render chính
RunService.RenderStepped:Connect(function(deltaTime)
    pcall(function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local cam = Workspace.CurrentCamera

        -- 1. Tốc độ chạy
        if hum and not Config.Fly then
            hum.WalkSpeed = Config.Speed and Config.SpeedValue or 16
        end

        -- 2. Tàng hình
        if char and Config.Invisibility then
            for _, v in ipairs(char:GetDescendants()) do
                pcall(function()
                    if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                        v.Transparency = 1
                    elseif v:IsA("Decal") then
                        v.Transparency = 1
                    elseif v:IsA("Accessory") then
                        local handle = v:FindFirstChild("Handle")
                        if handle then handle.Transparency = 1 end
                    end
                end)
            end
        end

        -- 3. Fly theo Camera
        if Config.Fly and not Config.TeleportToTarget and root and hum and cam then
            if not bv or not bv.Parent or not bg or not bg.Parent then 
                startFly() 
            end
            if bv and bg then
                hum.PlatformStand = true
                bg.CFrame = cam.CFrame

                local speed = Config.FlyValue or 50
                local moveDir = hum.MoveDirection

                if moveDir.Magnitude > 0 then
                    local rawMove = (cam.CFrame.LookVector * (-cam.CFrame:VectorToObjectSpace(moveDir).Z)) + (cam.CFrame.RightVector * (cam.CFrame:VectorToObjectSpace(moveDir).X))
                    bv.Velocity = rawMove * speed
                    holdPosition = root.Position
                else
                    bv.Velocity = Vector3.zero
                    if holdPosition then
                        root.CFrame = CFrame.new(holdPosition, holdPosition + cam.CFrame.LookVector)
                    end
                end
            end
        else
            if bv or bg then 
                stopFly() 
            end
        end

        -- 4. Xử lý Súng & Đạn
        handleGunAndAmmo()

        -- 5. Teleport RA SAU LƯNG Kẻ Địch
        if Config.TeleportToTarget and char and root then
            local enemyRoot, enemyHead = nil, nil
            local shortestDist = Config.MaxDistance
            
            for _, targetPlayer in ipairs(Players:GetPlayers()) do
                pcall(function()
                    if targetPlayer ~= player and not isTeammate(targetPlayer) then
                        local tChar = targetPlayer.Character
                        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                        local tHead = tChar and tChar:FindFirstChild("Head")
                        if tHum and tHum.Health > 0 and tRoot and tHead then
                            local dist = (root.Position - tRoot.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                enemyRoot = tRoot
                                enemyHead = tHead
                            end
                        end
                    end
                end)
            end

            if enemyRoot and enemyHead then
                root.CanCollide = false
                local behindCF = enemyRoot.CFrame * CFrame.new(0, 0, 3)
                local targetCF = CFrame.lookAt(behindCF.Position, Vector3.new(enemyHead.Position.X, behindCF.Position.Y, enemyHead.Position.Z), Vector3.yAxis)
                
                root.CFrame = targetCF
                
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
                
                if cam then
                    local targetCamCF = CFrame.new(cam.CFrame.Position, enemyHead.Position)
                    cam.CFrame = cam.CFrame:Lerp(targetCamCF, 0.4)
                end
            end
        else
            if root then
                root.CanCollide = true
            end
        end

        -- 6. Aim Assist & Tự Động Bắn
        local currentTargetHead = nil
        if cam and Config.AimAssist then
            currentTargetHead = getAimTarget()
            if currentTargetHead then
                local posicionObjetivo = currentTargetHead.Position
                if Config.AjusteDistanciaActivo then
                    posicionObjetivo = aplicarAjusteDistancia(posicionObjetivo)
                end
                local desiredCFrame = CFrame.lookAt(cam.CFrame.Position, posicionObjetivo)
                local factor = math.clamp((Config.AimStrength / 100) * (deltaTime * 30), 0.01, 1)
                cam.CFrame = cam.CFrame:Lerp(desiredCFrame, factor)
            end
        elseif fovCircle and not Config.AimAssist then
            fovCircle.Visible = false
        end

        if Config.AutoShoot and char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                if Config.AimAssist and currentTargetHead then
                    local now = tick()
                    if now - lastAutoShootTime >= 0.08 then
                        lastAutoShootTime = now
                        pcall(function() tool:Activate() end)
                        pcall(function()
                            VirtualUser:Button1Down(Vector2.zero)
                            task.delay(0.03, function() 
                                pcall(function() VirtualUser:Button1Up(Vector2.zero) end)
                            end)
                        end)
                    end
                end
            end
        end

        -- 7. Hitbox Expander & ESP
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            pcall(function()
                if targetPlayer ~= player then
                    local tChar = targetPlayer.Character
                    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    local tHead = tChar and tChar:FindFirstChild("Head")

                    if tRoot then
                        if Config.ExpandHitbox and not isTeammate(targetPlayer) then
                            tRoot.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                            tRoot.Transparency = Config.HitboxTransparency
                            tRoot.Color = Color3.fromRGB(255, 0, 0)
                            tRoot.Material = Enum.Material.SmoothPlastic
                            tRoot.CanCollide = false
                            tRoot.CustomPhysicalProperties = zeroPhysicalProps
                        else
                            tRoot.Size = Vector3.new(2, 2, 1)
                            tRoot.Transparency = 1
                        end
                    end

                    if tChar then
                        local highlight = tChar:FindFirstChild("HUB_ESP")
                        if Config.ESP then
                            if not highlight then
                                highlight = Instance.new("Highlight")
                                highlight.Name = "HUB_ESP"
                                highlight.Adornee = tChar
                                highlight.FillTransparency = 0.7
                                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                highlight.Parent = tChar
                            end
                            highlight.Enabled = true
                            highlight.OutlineColor = isTeammate(targetPlayer) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                        elseif highlight then
                            highlight.Enabled = false
                        end
                    end

                    if tHead and tHum then
                        local billboard = tHead:FindFirstChild("HUB_ESP_Tag")
                        if Config.ESPName or Config.ESPHealth then
                            if not billboard then
                                billboard = Instance.new("BillboardGui")
                                billboard.Name = "HUB_ESP_Tag"
                                billboard.Adornee = tHead
                                billboard.Size = UDim2.new(0, 200, 0, 50)
                                billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                                billboard.AlwaysOnTop = true

                                local label = Instance.new("TextLabel")
                                label.Name = "Text"
                                label.Size = UDim2.new(1, 0, 1, 0)
                                label.BackgroundTransparency = 1
                                label.TextSize = 13
                                label.Font = Enum.Font.GothamBold
                                label.TextStrokeTransparency = 0.2
                                label.Parent = billboard
                                billboard.Parent = tHead
                            end

                            local label = billboard:FindFirstChild("Text")
                            if label then
                                local textDisplay = ""
                                if Config.ESPName then textDisplay = targetPlayer.Name end
                                if Config.ESPHealth then
                                    local hp = math.floor(tHum.Health)
                                    local maxHp = math.floor(tHum.MaxHealth)
                                    if textDisplay ~= "" then
                                        textDisplay = textDisplay .. " | HP: " .. tostring(hp) .. "/" .. tostring(maxHp)
                                    else
                                        textDisplay = "HP: " .. tostring(hp) .. "/" .. tostring(maxHp)
                                    end
                                end
                                label.Text = textDisplay
                                label.TextColor3 = isTeammate(targetPlayer) and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 60, 60)
                            end
                            billboard.Enabled = true
                        elseif billboard then
                            billboard.Enabled = false
                        end
                    end
                end
            end)
        end
    end)
end)

